# ============================================================
# CelebrAI Event Planner — Environment Configuration Example
# ============================================================
# 1. Obtain an API key from Google AI Studio (https://aistudio.google.com)
# 2. Rename or copy this file to `.env.local`
# 3. Add your key and preferred model below:

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Storage Options:
# DATA_DIR=/path/to/persistent/volume  (optional, defaults to ./.data)
# DATABASE_URL=postgresql://user:pass@host:5432/db (optional external DB)

# Note: If GEMINI_API_KEY is omitted, CelebrAI operates smoothly in Demo Mode
# using deterministic domain planning templates and knowledge engine.
